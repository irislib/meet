{
  "name": "iris-meet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Private peer-to-peer video meetings on Nostr.",
  "repository": "https://git.iris.to/#/npub1xdhnr9mrv47kkrn95k6cwecearydeh8e895990n3acntwvmgk2dsdeeycm/meet",
  "homepage": "https://meet.iris.to/",
  "bugs": {
    "url": "https://git.iris.to/#/npub1xdhnr9mrv47kkrn95k6cwecearydeh8e895990n3acntwvmgk2dsdeeycm/meet?tab=issues"
  },
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "vite",
    "verify:dependency-lock": "node ./scripts/verify-dependency-lock.mjs",
    "build": "pnpm run verify:dependency-lock && vite build",
    "preview": "vite preview",
    "check": "pnpm run verify:dependency-lock && svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "pnpm run verify:dependency-lock && vitest run",
    "test:e2e": "pnpm run verify:dependency-lock && env -u NO_COLOR playwright test",
    "smoke:portable": "node ./scripts/smoke-meet-iris-portable.mjs",
    "publish:iris": "pnpm run verify:dependency-lock && node ./scripts/publish-iris-build.mjs",
    "release:iris": "pnpm run verify:dependency-lock && node ./scripts/release-site.mjs",
    "test:offline": "pnpm run verify:dependency-lock && PW_PREVIEW=1 playwright test"
  },
  "devDependencies": {
    "@iconify-json/carbon": "^1.2.24",
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/debug": "^4.1.13",
    "@types/node": "^24.13.3",
    "@unocss/preset-icons": "^66.7.5",
    "@unocss/preset-uno": "^66.7.5",
    "@unocss/transformer-directives": "^66.7.5",
    "svelte": "^5.56.5",
    "svelte-check": "^4.7.3",
    "typescript": "~5.9.3",
    "unocss": "^66.7.5",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "ws": "8.18.3",
    "@types/ws": "8.18.1"
  },
  "dependencies": {
    "@iris/svelte-ui": "https://github.com/mmalmi/iris-kit/releases/download/runtime-v0.2.6/iris-svelte-ui-0.1.2.tgz",
    "@noble/hashes": "^2.2.0",
    "@noble/secp256k1": "^3.1.0",
    "minidenticons": "^4.2.1",
    "nostr-tools": "2.23.12",
    "@iris/identity": "https://github.com/mmalmi/iris-kit/releases/download/runtime-v0.2.6/iris-identity-0.3.1.tgz",
    "@iris/hashtree-app": "https://github.com/mmalmi/iris-kit/releases/download/runtime-v0.2.6/iris-hashtree-app-0.1.5.tgz",
    "@hashtree/core": "https://github.com/mmalmi/hashtree/releases/download/hashtree-ts-runtime-v0.5.9/hashtree-core-0.3.2.tgz",
    "@hashtree/dexie": "https://github.com/mmalmi/hashtree/releases/download/hashtree-ts-runtime-v0.5.9/hashtree-dexie-0.1.11.tgz",
    "@hashtree/worker": "https://github.com/mmalmi/hashtree/releases/download/hashtree-ts-runtime-v0.5.11/hashtree-worker-0.4.7.tgz",
    "nostr-pubsub": "https://github.com/mmalmi/nostr-pubsub/releases/download/nostr-pubsub-ts-v0.5.13/nostr-pubsub-0.5.13.tgz",
    "nostr-social-graph": "https://github.com/mmalmi/nostr-social-graph/releases/download/v2.0.1/nostr-social-graph-2.0.1.tgz"
  },
  "pnpm": {
    "overrides": {
      "nostr-tools": "2.23.12",
      "dexie": "4.4.4",
      "@fips/tcp": "https://github.com/mmalmi/fips-tcp/releases/download/fips-tcp-v0.2.4/fips-tcp-0.2.3.tgz"
    }
  }
}
